PORT=5000
MONGODB_URI=mongodb+srv://<USER>:<PASS>@cluster0.tsejdgb.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_key
GOOGLE_CLIENT_ID=googleusercontent.com
NVIDIA_API_KEY=your_nvidia_key
# ==========================================
# NEW INFRASTRUCTURE VARIABLES
# ==========================================

# Redis Connection (Required for Cache, Rate Limiter, and BullMQ)
# Example: redis://localhost:6379 (local) or your managed Redis URL (e.g., Upstash, AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_STRICT_MAX=5

# Caching
# Default TTL for cached routes (in seconds)
CACHE_TTL=300

# Logging
# Set to 'info' for production, 'debug' for local development
LOG_LEVEL=info

# External API Timeout
# Maximum time (in milliseconds) the AI API will wait before aborting (Default: 60s)
AI_API_TIMEOUT=180000

# SMTP Configuration for OTP Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@atsresumebuilder.com
